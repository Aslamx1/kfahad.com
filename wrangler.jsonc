{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kfahad-com",
  "main": "worker.js",
  "compatibility_date": "2026-09-20",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    { "pattern": "kfahad.com/*", "zone_name": "kfahad.com" },
    { "pattern": "www.kfahad.com/*", "zone_name": "kfahad.com" },
    { "pattern": "kfahad.com", "custom_domain": true },
    { "pattern": "www.kfahad.com", "custom_domain": true }
  ],
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "RATE_LIMITER",
        "class_name": "RateLimiter"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RateLimiter"]
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kfahad-production",
      "database_id": "fdbde1a4-ada7-4849-a62b-fbd8257578dc"
    }
  ],
  "vars": {
    "AUTH_BACKEND_URL": "https://jocular-malabi-812ccf.netlify.app",
    "AUTH_ALLOWED_ORIGIN": "https://kfahad.com,https://www.kfahad.com,https://kfahad-com.amdernpropertiessmclimited.workers.dev",
    "ALLOWED_ORIGIN": "https://kfahad.com,https://www.kfahad.com,https://kfahad-com.amdernpropertiessmclimited.workers.dev",
    "APP_URL": "https://kfahad.com"
  }
}
